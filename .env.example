# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT_REF/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key
# Get this from: https://makersuite.google.com/app/apikey
VITE_API_KEY=your_gemini_api_key_here

# Note: For local development, create a .env.local file with your actual values
# This file should NOT be committed to git (already in .gitignore)
